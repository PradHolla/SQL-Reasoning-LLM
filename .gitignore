# Trained LoRA adapters and merged models (rebuild: sqlrl.training.*)
models/

# Trainer checkpoints, optimizer states, logs (rebuild: sqlrl.training.*)
outputs/

# Datasets: HF downloads, processed JSONL, benchmark SQLite DBs
# (rebuild: sqlrl.data_prep.*)
data/

# Benchmark databases and scratch SQLite files
*.sqlite
*.sqlite3
*.db

# Secrets
.env
.env.*
!.env.example

# Working notes / roadmap — kept local, not published
BLUEPRINT.md

# Run logs live in the repo (not /tmp, which an idle-shutdown reboot wipes --
# see infra/run.sh) but they are machine-local and must never be committed.
logs/
.venv-teacher/

# Built artifact: source is committed, the multi-MB build with embedded
# base64 figures is not — rebuild with `python artifact/build.py`.
artifact/build/
